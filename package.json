{
  "name": "agentflow-ops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "coordinator:install": "node scripts/install-coordinator-skill.mjs",
    "dsh:doctor": "node scripts/dsh-worker.mjs doctor",
    "dsh:run": "node scripts/dsh-worker.mjs run",
    "test:dsh": "node --test tests/dsh-worker.test.mjs",
    "pro": "oracle",
    "pro:task": "node scripts/pro-task.mjs",
    "pro:doctor": "node scripts/pro-doctor.mjs",
    "pro:bundle": "oracle --engine browser --model gpt-6-pro --render-plain --render",
    "test:pro": "node --test tests/pro-task.test.mjs",
    "tools": "mcporter",
    "browser": "chrome-devtools-mcp"
  },
  "dependencies": {
    "@steipete/oracle": "0.22.0",
    "chrome-devtools-mcp": "1.12.0",
    "mcporter": "0.16.0"
  },
  "packageManager": "pnpm@11.25.0"
}
